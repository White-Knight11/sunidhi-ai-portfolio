# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is git-ignored. NEVER commit real keys.

GEMINI_API_KEY = "your-gemini-api-key"
ADMIN_PASSWORD = "choose-a-strong-password"

# Optional: lets the Manage page commit new projects to GitHub,
# so they survive redeploys on Streamlit Cloud.
GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "your-username/your-repo"
GITHUB_BRANCH = "main"

# Optional: override the model
# GEMINI_MODEL = "gemini-2.5-flash"
